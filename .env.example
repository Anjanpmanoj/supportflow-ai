# Copy to .env for local development. Never commit the real .env.
# On Render, set these in the service's Environment tab instead.

# --- Backend (required) ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
GEMINI_API_KEY=

# --- Backend (optional) ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTO_ASSIGN=true
AUTO_SEND_AI_REPLY=true
# simple = lightweight lookup (default). vector = Chroma + local embeddings
# (needs: pip install -r requirements-vector.txt, ~2 GB, local use only)
KNOWLEDGE_BASE=simple
DATABASE_PATH=supportflow.db

# --- Optional: trace the LangGraph workflow in LangSmith ---
# Note: traces contain customer messages, so keep this off for real customer data.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supportflow-ai

# --- First admin, created on startup if it does not exist ---
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Sample data for demos (only seeds an empty database) ---
SEED_DEMO_DATA=false
DEMO_PASSWORD=

# --- Frontend ---
SUPPORTFLOW_API_URL=http://127.0.0.1:8000
